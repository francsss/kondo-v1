{
  "name": "kondo-v1-clean",
  "version": "1.0.0-rc.1",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node --env-file-if-exists=.env scripts/production-build.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "EMAIL_PROVIDER=console node --env-file-if-exists=.env scripts/prepare-test-db.mjs && EMAIL_PROVIDER=console node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "e2e": "env -u NO_COLOR playwright test",
    "e2e:ui": "env -u NO_COLOR playwright test --ui",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "reference:generate": "tsx scripts/generate-moe-reference-data.ts",
    "media:cleanup": "tsx scripts/cleanup-media.ts",
    "notifications:process": "tsx scripts/process-notifications.ts",
    "notifications:digest": "tsx scripts/send-email-digests.ts",
    "marketplace:expire": "tsx scripts/expire-listings.ts",
    "housing:expire": "tsx scripts/expire-housing.ts",
    "community-requests:expire": "tsx scripts/expire-community-requests.ts",
    "stories:publish": "tsx scripts/publish-scheduled-stories.ts",
    "posthog:setup": "node scripts/setup-posthog-dashboards.mjs",
    "admin:bootstrap": "tsx scripts/bootstrap-super-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1088.0",
    "@aws-sdk/s3-request-presigner": "^3.1088.0",
    "@googlemaps/js-api-loader": "^2.1.1",
    "@livekit/components-react": "^2.9.23",
    "@livekit/components-styles": "^1.2.0",
    "@napi-rs/canvas": "^0.1.100",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-slot": "^1.3.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "jose": "^5.9.6",
    "livekit-client": "^2.20.2",
    "livekit-server-sdk": "^2.17.0",
    "lucide-react": "^1.24.0",
    "next": "^16.2.11",
    "next-themes": "^0.4.6",
    "pdf-to-img": "^6.2.0",
    "pdfjs-dist": "^5.6.205",
    "posthog-js": "^1.407.2",
    "posthog-node": "^5.46.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.17.2",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/google.maps": "^3.65.3",
    "@types/node": "^20.17.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "pinyin-pro": "^3.28.2",
    "postcss": "^8.5.22",
    "prettier": "^3.9.5",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "prisma@5.22.0": true,
    "sharp@0.35.3": true,
    "unrs-resolver@1.12.2": true
  }
}
