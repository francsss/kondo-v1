# ---------------------------------------------------------------------------
# Database (PostgreSQL). In production use a managed, pooled connection (e.g.
# Neon/PgBouncer) for DATABASE_URL and a direct connection for DIRECT_URL.
# For a local, non-pooled database set DIRECT_URL to the same value.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://kondo:kondo_password@localhost:5432/kondo?schema=public"
DIRECT_URL="postgresql://kondo:kondo_password@localhost:5432/kondo?schema=public"
# Disposable database for the integration/API test suite (CI/test only).
TEST_DATABASE_URL="postgresql://kondo:kondo_password@localhost:5432/kondo_module3_test?schema=public"

# ---------------------------------------------------------------------------
# Core application
# ---------------------------------------------------------------------------
# Signs session cookies AND media tokens. Use >=32 random bytes. Required in
# production. Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
# Canonical HTTPS origin. Baked into email links (verification/reset/digest)
# and page metadata. Required in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Must be exactly "true" only for an intentional non-production demo reset.
# Never set in production (the seed refuses prod regardless).
KONDO_ALLOW_DESTRUCTIVE_SEED="false"
# Optional: extra comma-separated dev-only origins for Next HMR (LAN testing).
KONDO_DEV_ORIGINS=""

# ---------------------------------------------------------------------------
# Object storage (media). "local" for dev/test; "s3" for production (local is
# rejected in production). Any S3-compatible provider works — e.g. Cloudflare
# R2: set STORAGE_REGION=auto, STORAGE_ENDPOINT to the R2 S3 API endpoint, and
# use an API token with Object Read & Write on a PRIVATE bucket (no public
# access; media is served through the app via presigned URLs).
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT=".data/media"
STORAGE_BUCKET="kondo-local"
STORAGE_REGION="auto"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# ---------------------------------------------------------------------------
# Background worker / cron authentication.
# Vercel Cron sends `Authorization: Bearer <CRON_SECRET>` to the internal
# routes below. The per-worker secrets remain valid for manual POST triggers
# and non-Vercel schedulers. Generate each with: openssl rand -hex 32
#   /api/internal/notifications/process  -> CRON_SECRET | NOTIFICATION_WORKER_SECRET
#   /api/internal/notifications/digest   -> CRON_SECRET | NOTIFICATION_WORKER_SECRET
#   /api/internal/marketplace/expire     -> CRON_SECRET | MARKETPLACE_WORKER_SECRET
#   /api/internal/media/cleanup          -> CRON_SECRET | MEDIA_WORKER_SECRET
# ---------------------------------------------------------------------------
CRON_SECRET=""
NOTIFICATION_WORKER_SECRET="replace-with-a-separate-long-random-secret"
MARKETPLACE_WORKER_SECRET="replace-with-a-separate-long-random-secret"
MEDIA_WORKER_SECRET="replace-with-a-separate-long-random-secret"

# ---------------------------------------------------------------------------
# Transactional email. Leave RESEND_API_KEY empty to no-op outside production
# (dev). Set EMAIL_PROVIDER=resend (auto-selected once the key exists),
# RESEND_API_KEY, and EMAIL_FROM (on a Resend-verified domain) to send real
# email. Production throws rather than silently dropping mail if unset.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM=""

# ---------------------------------------------------------------------------
# Shared rate limiting (Upstash Redis, REST). Optional: the limiter falls back
# to a per-instance in-memory store when unset. Recommended in production so
# limits are shared across serverless instances.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
