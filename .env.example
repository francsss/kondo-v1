# Copy this file to .env for local development. Never commit real values.
# Vercel supplies NODE_ENV and VERCEL_ENV; CI providers supply CI.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Runtime connection. Use Neon's pooled hostname in production.
DATABASE_URL="postgresql://kondo:kondo_password@localhost:5432/kondo?schema=public"
# Migration connection. Use Neon's direct (non-pooler) hostname in production.
DIRECT_URL="postgresql://kondo:kondo_password@localhost:5432/kondo?schema=public"
# Disposable database used only by Vitest/integration tests and CI.
TEST_DATABASE_URL="postgresql://kondo:kondo_password@localhost:5432/kondo_module3_test?schema=public"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Required in production. Generate at least 32 random bytes:
#   openssl rand -base64 48
JWT_SECRET=""
# Exact canonical origin, with no trailing slash. Required in production for
# page metadata, email verification/reset links, and notification digests.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Destructive seed opt-in. Leave false/unset in every shared or production env.
KONDO_ALLOW_DESTRUCTIVE_SEED="false"
# Optional comma-separated development-only origins for Next.js HMR/LAN use.
KONDO_DEV_ORIGINS=""

# Temporary MVP feedback mascot. Set to "false" and redeploy to remove every
# Kondo Pet entry point without changing application code or stored feedback.
NEXT_PUBLIC_KONDO_PET_ENABLED="true"

# ---------------------------------------------------------------------------
# Product analytics (PostHog)
# ---------------------------------------------------------------------------
# Public project token and ingestion host. Analytics is disabled when omitted.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# Management API values are used only by `npm run posthog:setup`.
# Keep the personal API key server-side and out of the browser.
POSTHOG_PERSONAL_API_KEY=""
POSTHOG_PROJECT_ID=""
POSTHOG_API_HOST="https://us.posthog.com"

# ---------------------------------------------------------------------------
# Media storage
# ---------------------------------------------------------------------------
# Local development: local. Production: s3 (local is rejected in production).
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT=".data/media"
# Cloudflare R2 production values:
#   bucket: private bucket name
#   region: auto
#   endpoint: https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_BUCKET="kondo-local"
STORAGE_REGION="auto"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# ---------------------------------------------------------------------------
# Scheduled jobs and worker authentication
# ---------------------------------------------------------------------------
# Required in Vercel and as a GitHub Actions repository secret for the
# scheduled-worker workflow. Generate each configured secret independently:
#   openssl rand -hex 32
CRON_SECRET=""
# Optional route-specific alternatives for manual/external worker calls.
NOTIFICATION_WORKER_SECRET=""
MARKETPLACE_WORKER_SECRET=""
# Shared secret for POST /api/internal/opportunities/expire (opportunity deadline expiry).
OPPORTUNITY_WORKER_SECRET=""
MEDIA_WORKER_SECRET=""

# ---------------------------------------------------------------------------
# Transactional email
# ---------------------------------------------------------------------------
# Local development: console. Production: resend.
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
# Sender on a Resend-verified domain, e.g. Kondo <no-reply@example.com>.
EMAIL_FROM=""

# ---------------------------------------------------------------------------
# Shared production rate limiting
# ---------------------------------------------------------------------------
# Both values are required together for shared limits. If omitted, Kondo falls
# back to a per-instance in-memory limiter, which is not production-grade on
# horizontally scaled Vercel functions.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------------------------------------------------------------------
# Student timetable analysis (server-only)
# ---------------------------------------------------------------------------
# Required in production for PDF/image timetable extraction. Never prefix this
# variable with NEXT_PUBLIC_. Images and scanned PDFs are OCR-processed on the
# server before their extracted text is sent to DeepSeek.
DEEPSEEK_API_KEY=""
SCHEDULE_AI_PROVIDER="deepseek"
# Optional model override. Keep unset to use the reviewed application default.
SCHEDULE_AI_MODEL=""
# Optional provider timeout in milliseconds (clamped between 10000 and 120000).
SCHEDULE_AI_TIMEOUT_MS="120000"

# ---------------------------------------------------------------------------
# Meet real map (Google Maps JavaScript API browser key)
# ---------------------------------------------------------------------------
# Public browser key restricted to joinkondo.com and approved Preview domains.
# Enable Maps JavaScript API and Geocoding API for the key. Kondo sends only
# public university/city anchors and privacy-safe approximate marker positions.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ---------------------------------------------------------------------------
# Web Push notifications (VAPID key pair)
# ---------------------------------------------------------------------------
# Generate the pair once with: npx web-push generate-vapid-keys
# Leaving any of the three unset keeps Kondo fully functional: in-app banners and
# the notification centre still work, and only OS-level push delivery is skipped.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=""
# Server-only. Never add a NEXT_PUBLIC_ prefix to the private key.
WEB_PUSH_VAPID_PRIVATE_KEY=""
# Contact identity sent to push services, as mailto: or an https URL.
WEB_PUSH_SUBJECT="mailto:support@joinkondo.com"

# ---------------------------------------------------------------------------
# Audio/video calls (LiveKit Cloud, server-only credentials)
# ---------------------------------------------------------------------------
# Project WebSocket URL, for example wss://your-project.livekit.cloud.
LIVEKIT_URL=""
# Both credentials are used only by server routes to mint short-lived,
# room-scoped participant tokens. Never prefix them with NEXT_PUBLIC_.
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# ---------------------------------------------------------------------------
# Playwright / CI (optional; never needed by the production runtime)
# ---------------------------------------------------------------------------
PLAYWRIGHT_PORT="3100"
# PLAYWRIGHT_BASE_URL="https://preview.example.com"
PLAYWRIGHT_SKIP_WEB_SERVER=""
# PLAYWRIGHT_TEST_EMAIL="e2e-member@example.com"
# PLAYWRIGHT_TEST_PASSWORD=""
# PLAYWRIGHT_ADMIN_EMAIL="e2e-admin@example.com"
# PLAYWRIGHT_ADMIN_PASSWORD=""

# Optional. Enables the Kondo study assistant in the Study Essentials reader.
# Server-only — never exposed to the browser. Unset: the assistant is offered
# as unavailable and the rest of the reader is unaffected.
ANTHROPIC_API_KEY=
