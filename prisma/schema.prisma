model User {
  id                                 String                            @id @default(cuid())
  email                              String                            @unique
  emailVerifiedAt                    DateTime?
  passwordHash                       String?
  firstName                          String
  lastName                           String
  username                           String?                           @unique
  avatarKey                          String?
  avatarMediaId                      String?                           @unique
  avatarMedia                        MediaAsset?                       @relation("UserAvatar", fields: [avatarMediaId], references: [id], onDelete: SetNull)
  bio                                String?                           @db.VarChar(280)
  phone                              String?
  profileAudience                    ProfileAudience                   @default(MEMBERS)
  locationAudience                   ProfileAudience                   @default(MEMBERS)
  educationAudience                  ProfileAudience                   @default(MEMBERS)
  languagesAudience                  ProfileAudience                   @default(MEMBERS)
  communitiesAudience                ProfileAudience                   @default(MEMBERS)
  activityAudience                   ProfileAudience                   @default(MEMBERS)
  marketplaceAudience                ProfileAudience                   @default(MEMBERS)
  role                               Role                              @default(MEMBER)
  status                             UserStatus                        @default(ACTIVE)
  storyCreatorStatus                 StoryCreatorStatus                @default(STANDARD)
  officialProfileStatus              OfficialProfileStatus             @default(NOT_VERIFIED)
  officialOrganizationType           OfficialOrganizationType?
  officialOrganizationName           String?                           @db.VarChar(160)
  officialVerifiedAt                 DateTime?
  officialReviewDueAt                DateTime?
  gender                             UserGender?
  countryId                          String?
  country                            Country?                          @relation(fields: [countryId], references: [id], onDelete: SetNull)
  cityId                             String?
  city                               City?                             @relation(fields: [cityId], references: [id], onDelete: SetNull)
  universityId                       String?
  university                         University?                       @relation(fields: [universityId], references: [id], onDelete: SetNull)
  degree                             String?
  studyLevel                         StudyLevel?
  studentJourney                     StudentJourney?
  onboardingIntent                   OnboardingIntent?
  journeyDetail                      UserJourneyDetail?
  targetCities                       UserTargetCity[]
  targetUniversities                 UserTargetUniversity[]
  organizationMemberships            OrganizationMembership[]
  createdOrganizations               Organization[]                    @relation("OrganizationCreator")
  sentOrganizationInvitations        OrganizationInvitation[]          @relation("OrganizationInvitationSender")
  removedOrganizationMemberships     OrganizationMembership[]          @relation("OrganizationMembershipRemovedBy")
  submittedOrganizationVerifications OrganizationVerificationRequest[] @relation("OrganizationVerificationSubmitter")
  reviewedOrganizationVerifications  OrganizationVerificationRequest[] @relation("OrganizationVerificationReviewer")
  initiatedOrganizationTransfers     OrganizationOwnershipTransfer[]   @relation("OrganizationOwnershipTransferInitiator")
  targetedOrganizationTransfers      OrganizationOwnershipTransfer[]   @relation("OrganizationOwnershipTransferTarget")
  grantedOrganizationPartnerships    Organization[]                    @relation("OrganizationPartnerGranter")
  createdOrganizationMedia           OrganizationMedia[]               @relation("OrganizationMediaCreator")
  nearbyDiscoveryEnabled             Boolean                           @default(true)
  meetIntents                        String[]                          @default([])
  studyYear                          Int?
  arrivalDate                        DateTime?
  languages                          String[]                          @default([])
  interests                          String[]                          @default([])
  onboardingCompletedAt              DateTime?
  lastActiveAt                       DateTime?
  createdCommunities                 Community[]                       @relation("CommunityCreator")
  ownedCommunities                   Community[]                       @relation("CommunityOwner")
  communityMemberships               CommunityMember[]
  communityAccessSubjects            CommunityAccessRequest[]          @relation("CommunityAccessSubject")
  createdCommunityAccessRequests     CommunityAccessRequest[]          @relation("CommunityAccessCreator")
  resolvedCommunityAccessRequests    CommunityAccessRequest[]          @relation("CommunityAccessResolver")
  communityRequests                  CommunityRequest[]                @relation("CommunityRequestCreator")
  communityRequestHelpOffers         CommunityRequestHelpOffer[]
  posts                              Post[]
  comments                           Comment[]
  reactions                          Reaction[]
  stories                            Story[]                           @relation("StoryCreator")
  storyComments                      StoryComment[]
  storyLikes                         StoryLike[]
  storySaves                         StorySave[]
  storyHides                         StoryHide[]
  storyModerationEvents              StoryModerationEvent[]            @relation("StoryModerationActor")
  officialVerificationRequests       OfficialVerificationRequest[]     @relation("OfficialVerificationApplicant")
  reviewedOfficialVerifications      OfficialVerificationRequest[]     @relation("OfficialVerificationReviewer")
  marketplaceListings                MarketplaceListing[]
  personalHousingListings            HousingListing[]                  @relation("HousingPersonalPublisher")
  createdHousingListings             HousingListing[]                  @relation("HousingListingCreator")
  representedHousingListings         HousingListing[]                  @relation("HousingListingRepresentative")
  housingListingModerations          HousingListing[]                  @relation("HousingListingModerator")
  savedHousingListings               HousingSavedListing[]
  housingInquiries                   HousingInquiry[]                  @relation("HousingInquiryRequester")
  receivedHousingInquiries           HousingInquiry[]                  @relation("HousingInquiryRecipient")
  housingRequests                    HousingRequest[]
  roommateProfile                    RoommateProfile?
  sentRoommateInterests              RoommateInterest[]                @relation("RoommateInterestSender")
  receivedRoommateInterests          RoommateInterest[]                @relation("RoommateInterestRecipient")
  communityExchangeOffers            CommunityExchangeOffer[]
  studentSkillOffers                 StudentSkillOffer[]
  listingFavorites                   ListingFavorite[]
  guideProgress                      GuideProgress[]
  createdGuides                      Guide[]                           @relation("GuideAuthor")
  createdCityHubs                    CityHub[]                         @relation("CityHubAuthor")
  updatedCityHubs                    CityHub[]                         @relation("CityHubEditor")
  questions                          Question[]
  answers                            Answer[]
  answerVotes                        AnswerVote[]
  studentSchedules                   StudentSchedule[]
  scheduleImports                    ScheduleImport[]
  academicTasks                      AcademicTask[]
  customPeriodConfigurations         CustomPeriodConfiguration[]
  scholarshipFavorites               ScholarshipFavorite[]
  bookmarks                          Bookmark[]
  notifications                      Notification[]                    @relation("NotificationRecipient")
  pushSubscriptions                  PushSubscription[]
  triggeredNotifications             Notification[]                    @relation("NotificationActor")
  notificationJobs                   NotificationJob[]                 @relation("NotificationJobRecipient")
  triggeredNotificationJobs          NotificationJob[]                 @relation("NotificationJobActor")
  updatedNotificationTemplates       NotificationTemplate[]            @relation("NotificationTemplateUpdater")
  createdNotificationAnnouncements   NotificationAnnouncement[]        @relation("NotificationAnnouncementCreator")
  conversationMemberships            ConversationParticipant[]
  sentMessages                       Message[]                         @relation("MessageSender")
  meetQueueEntry                     MeetQueueEntry?
  meetDiscoveryProfile               MeetDiscoveryProfile?
  subscriptions                      UserSubscription[]
  createdCallSessions                CallSession[]                     @relation("CallSessionCreator")
  callParticipations                 CallParticipant[]
  blockedUsers                       UserBlock[]                       @relation("Blocker")
  blockedByUsers                     UserBlock[]                       @relation("BlockedUser")
  reports                            Report[]                          @relation("ReportReporter")
  reportedSubjects                   Report[]                          @relation("ReportSubject")
  assignedReports                    Report[]                          @relation("ReportAssignee")
  reportAssignments                  Report[]                          @relation("ReportAssignedBy")
  resolvedReports                    Report[]                          @relation("ReportResolvedBy")
  reopenedReports                    Report[]                          @relation("ReportReopenedBy")
  reportNotes                        ReportNote[]
  reportEvidenceCaptures             ReportEvidence[]
  submittedPetFeedbacks              PetFeedback[]                     @relation("PetFeedbackAuthor")
  resolvedPetFeedbacks               PetFeedback[]                     @relation("PetFeedbackResolver")
  petFeedbackNotes                   PetFeedbackNote[]                 @relation("PetFeedbackNoteAuthor")
  ownedMedia                         MediaAsset[]                      @relation("MediaOwner")
  removedMedia                       MediaAsset[]                      @relation("MediaRemovedBy")
  accountRequests                    AccountRequest[]                  @relation("AccountRequestOwner")
  processedAccountRequests           AccountRequest[]                  @relation("AccountRequestProcessor")
  preference                         UserPreference?
  auditLogs                          AuditLog[]                        @relation("AuditActor")
  analyticsEvents                    AnalyticsEvent[]
  presence                           UserPresence?
  accounts                           OAuthAccount[]
  sessions                           Session[]
  emailVerificationTokens            EmailVerificationToken[]
  passwordResetTokens                PasswordResetToken[]
  createdAt                          DateTime                          @default(now())
  updatedAt                          DateTime                          @updatedAt
  searchVector                       Unsupported("tsvector")?

  @@index([countryId])
  @@index([cityId])
  @@index([universityId])
  @@index([status, lastActiveAt])
  @@index([profileAudience, status])
}

model Country {
  id                               String                            @id @default(cuid())
  code                             String                            @unique @db.Char(2)
  name                             String                            @unique
  emoji                            String?
  isActive                         Boolean                           @default(true)
  verified                         Boolean                           @default(false)
  users                            User[]
  cities                           City[]
  universities                     University[]
  communities                      Community[]
  scholarships                     Scholarship[]
  scholarshipAgents                ScholarshipAgent[]
  meetQueuePreferences             MeetQueueEntry[]                  @relation("MeetCountryPreference")
  organizations                    Organization[]
  housingListings                  HousingListing[]
  organizationVerificationRequests OrganizationVerificationRequest[]
  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt

  @@index([isActive, name])
}

model UserPreference {
  userId                      String             @id
  user                        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme                       ThemePreference    @default(SYSTEM)
  language                    AppLanguage        @default(ENGLISH)
  notificationMessages        Boolean            @default(true)
  notificationComments        Boolean            @default(true)
  notificationMarketplace     Boolean            @default(true)
  notificationHousing         Boolean            @default(true)
  notificationAnnouncements   Boolean            @default(true)
  notificationCommunity       Boolean            @default(true)
  notificationMeet            Boolean            @default(true)
  notificationAcademic        Boolean            @default(true)
  notificationRecommendations Boolean            @default(true)
  notificationFriends         Boolean            @default(true)
  notificationEvents          Boolean            @default(true)
  notificationTransfers       Boolean            @default(true)
  notificationUniversity      Boolean            @default(true)
  notificationSecurity        Boolean            @default(true)
  notificationMarketing       Boolean            @default(false)
  notificationSounds          Boolean            @default(false)
  notificationHaptics         Boolean            @default(true)
  emailDigest                 NotificationDigest @default(NEVER)
  lastDigestSentAt            DateTime?
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  @@index([emailDigest, lastDigestSentAt])
}

model City {
  id                    String                   @id @default(cuid())
  slug                  String                   @unique
  name                  String
  province              String?
  countryId             String
  country               Country                  @relation(fields: [countryId], references: [id], onDelete: Restrict)
  isActive              Boolean                  @default(true)
  verified              Boolean                  @default(false)
  users                 User[]
  universities          University[]
  communities           Community[]
  listings              MarketplaceListing[]
  housingListings       HousingListing[]
  housingRequests       HousingRequest[]
  roommateProfiles      RoommateProfile[]
  exchangeOffers        CommunityExchangeOffer[]
  skillOffers           StudentSkillOffer[]
  meetDiscoveryProfiles MeetDiscoveryProfile[]   @relation("MeetDiscoveryCity")
  cityHub               CityHub?
  storyLinks            StoryEntityLink[]
  organizations         Organization[]
  userTargetPreferences UserTargetCity[]
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@unique([countryId, name])
  @@index([countryId])
  @@index([countryId, isActive, name])
}

