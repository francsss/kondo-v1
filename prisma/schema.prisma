// ---------------------------------------------------------------------------
// Part 5 — Opportunities (scholarships, internships, jobs, research, programs)
//
// The Opportunity domain is the single source of truth for opportunity records.
// It never stores a second copy of Housing, Marketplace, Community or Story
// content, and it does not rewrite the legacy Scholarship/ScholarshipAgent
// records: those keep their own models and are exposed through a read-only
// compatibility adapter until a later part decides on migration.
// ---------------------------------------------------------------------------

enum OpportunityType {
  SCHOLARSHIP
  INTERNSHIP
  GRADUATE_INTERNSHIP
  PART_TIME_JOB
  FULL_TIME_JOB
  CAMPUS_JOB
  RESEARCH_OPPORTUNITY
  VOLUNTEERING
  COMPETITION
  EXCHANGE_PROGRAM
  SUMMER_PROGRAM
  OTHER_PROGRAM
}

enum OpportunityPublisherType {
  ORGANIZATION
  EDITORIAL
  LEGACY_SCHOLARSHIP_AGENT
}

enum OpportunityLifecycleStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  PAUSED
  CLOSED
  EXPIRED
  REJECTED
  REMOVED
  ARCHIVED
}

enum OpportunityApplicationMethod {
  KONDO_APPLICATION
  EXTERNAL_URL
  EMAIL
  INFORMATION_ONLY
  NOMINATION_REQUIRED
}

enum OpportunityWorkMode {
  ON_SITE
  REMOTE
  HYBRID
  CAMPUS
  UNSPECIFIED
}

enum OpportunityFundingType {
  FULLY_FUNDED
  PARTIALLY_FUNDED
  TUITION_ONLY
  STIPEND_ONLY
  FEE_WAIVER
  OTHER
}

enum OpportunityEmploymentType {
  INTERNSHIP
  PART_TIME
  FULL_TIME
  TEMPORARY
  CONTRACT
  CAMPUS
  VOLUNTEER
  RESEARCH_ASSISTANT
  TEACHING_ASSISTANT
}

enum OpportunityExperienceLevel {
  NO_EXPERIENCE
  ENTRY_LEVEL
  INTERMEDIATE
  EXPERIENCED
  UNSPECIFIED
}

enum OpportunitySalaryPeriod {
  HOUR
  DAY
  WEEK
  MONTH
  YEAR
  TOTAL
}

enum OpportunityBenefitType {
  TUITION
  ACCOMMODATION
  STIPEND
  SALARY
  INSURANCE
  TRAVEL
  REGISTRATION_FEE
  MEALS
  TRANSPORT
  VISA_SUPPORT
  HOUSING_SUPPORT
  OTHER
}

// Benefits are never presented as guaranteed unless the publisher confirmed
// them. "Possible" and "not specified" stay visually and structurally distinct.
enum OpportunityBenefitConfidence {
  CONFIRMED
  POSSIBLE
  NOT_SPECIFIED
}

enum OpportunityEligibilityRuleType {
  ACCOUNT_JOURNEY
  STUDENT_STATUS
  DEGREE_LEVEL
  UNIVERSITY
  FIELD_OF_STUDY
  GRADUATION_YEAR
  COUNTRY
  NATIONALITY
  RESIDENCE
  AGE
  GPA
  LANGUAGE
  EXPERIENCE
  SKILL
  AVAILABILITY
  ENROLLMENT_STATUS
  CUSTOM
}

enum OpportunityEligibilityOperator {
  EQUALS
  NOT_EQUALS
  IN
  NOT_IN
  AT_LEAST
  AT_MOST
  BETWEEN
  EXISTS
  CUSTOM
}

enum OpportunityLanguageLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
  FLUENT
  NATIVE
}

enum OpportunityDocumentCategory {
  CV
  RESUME
  TRANSCRIPT
  ENROLLMENT_CERTIFICATE
  RECOMMENDATION_LETTER
  MOTIVATION_LETTER
  LANGUAGE_CERTIFICATE
  PORTFOLIO
  RESEARCH_PROPOSAL
  PASSPORT_COPY
  OTHER
}

enum OpportunityQuestionType {
  SHORT_TEXT
  LONG_TEXT
  SELECT
  MULTI_SELECT
  DATE
  NUMBER
  BOOLEAN
  FILE
  CONSENT
}

enum OpportunityApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  MORE_INFORMATION_REQUIRED
  SHORTLISTED
  INTERVIEW
  OFFERED
  ACCEPTED
  DECLINED_BY_APPLICANT
  REJECTED
  WITHDRAWN
  EXPIRED
  CANCELLED
}

enum OpportunityInterviewFormat {
  VIDEO
  PHONE
  IN_PERSON
  OTHER
}

enum OpportunityInterviewStatus {
  PROPOSED
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
}

enum OpportunityMediaKind {
  COVER
  GALLERY
  PUBLIC_DOCUMENT
}

model Opportunity {
  id                      String                     @id @default(cuid())
  slug                    String                     @unique
  type                    OpportunityType
  lifecycle               OpportunityLifecycleStatus @default(DRAFT)
  publisherType           OpportunityPublisherType
  publisherOrganizationId String?
  publisherOrganization   Organization?              @relation("OrganizationOpportunities", fields: [publisherOrganizationId], references: [id], onDelete: Cascade)
  scholarshipAgentId      String?
  scholarshipAgent        ScholarshipAgent?          @relation("ScholarshipAgentOpportunities", fields: [scholarshipAgentId], references: [id], onDelete: SetNull)
  createdByUserId         String?
  createdByUser           User?                      @relation("OpportunityCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  universityId            String?
  university              University?                @relation(fields: [universityId], references: [id], onDelete: SetNull)
  countryId               String?
  country                 Country?                   @relation(fields: [countryId], references: [id], onDelete: SetNull)
  cityId                  String?
  city                    City?                      @relation(fields: [cityId], references: [id], onDelete: SetNull)

  title            String              @db.VarChar(180)
  shortDescription String              @db.VarChar(400)
  description      String              @db.Text
  workMode         OpportunityWorkMode @default(UNSPECIFIED)
  locationLabel    String?             @db.VarChar(200)

  applicationMethod      OpportunityApplicationMethod
  externalApplicationUrl String?                      @db.VarChar(500)
  applicationEmail       String?                      @db.VarChar(320)
  officialSourceUrl      String?                      @db.VarChar(500)
  // Set by moderation when an external source is judged unsafe. While present,
  // the public apply action is suppressed even for a PUBLISHED opportunity.
  externalUrlBlockedAt   DateTime?

  applicationOpenAt    DateTime?
  applicationDeadline  DateTime?
  rollingApplications  Boolean   @default(false)
  expectedDecisionDate DateTime? @db.Date
  opportunityStartDate DateTime? @db.Date
  opportunityEndDate   DateTime? @db.Date
  timezone             String    @default("Asia/Shanghai") @db.VarChar(64)

  // Platform moderation. Independent from lifecycle so a restore can return the
  // opportunity to its previous publishing state.
  publicationBlockedAt   DateTime?
  publicationBlockedById String?
  publicationBlockedBy   User?     @relation("OpportunityBlockedBy", fields: [publicationBlockedById], references: [id], onDelete: SetNull)
  moderationNote         String?   @db.VarChar(2000)
  publisherVisibleNote   String?   @db.VarChar(2000)

  // Legacy/imported deduplication signature. Prevents the compatibility adapter
  // and editorial imports from producing a second visible copy of one source.
  legacySourceKey String? @unique @db.VarChar(300)

  publishedAt  DateTime?
  submittedAt  DateTime?
  closedAt     DateTime?
  expiresAt    DateTime?
  archivedAt   DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  searchVector Unsupported("tsvector")?

  scholarshipDetail    OpportunityScholarshipDetail?
  jobDetail            OpportunityJobDetail?
  degreeLevels         OpportunityDegreeLevel[]
  fieldsOfStudy        OpportunityFieldOfStudy[]
  languageRequirements OpportunityLanguageRequirement[]
  eligibilityRules     OpportunityEligibilityRule[]
  benefits             OpportunityBenefit[]
  requirements         OpportunityApplicationRequirement[]
  questions            OpportunityApplicationQuestion[]
  media                OpportunityMedia[]
  savedBy              OpportunitySaved[]
  applications         OpportunityApplication[]

  @@index([lifecycle, applicationDeadline])
  @@index([lifecycle, publishedAt])
  @@index([type, lifecycle, publishedAt])
  @@index([publisherOrganizationId, lifecycle, publishedAt])
  @@index([scholarshipAgentId])
  @@index([universityId, lifecycle])
  @@index([countryId, cityId, lifecycle])
  @@index([createdByUserId, createdAt])
  @@index([lifecycle, expiresAt])
}

model OpportunityScholarshipDetail {
  opportunityId          String                 @id
  opportunity            Opportunity            @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fundingType            OpportunityFundingType
  tuitionCoverage        String?                @db.VarChar(300)
  accommodationCoverage  String?                @db.VarChar(300)
  monthlyStipendMinor    Int?
  stipendCurrency        String?                @db.VarChar(3)
  insuranceCoverage      String?                @db.VarChar(300)
  travelCoverage         String?                @db.VarChar(300)
  applicationFeeMinor    Int?
  applicationFeeCurrency String?                @db.VarChar(3)
  nominationRequired     Boolean                @default(false)
  targetPrograms         String[]               @default([])
  intakeLabel            String?                @db.VarChar(120)
  studyLanguage          String?                @db.VarChar(80)
  durationLabel          String?                @db.VarChar(120)
  renewalConditions      String?                @db.VarChar(1000)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([fundingType])
}

model OpportunityJobDetail {
  opportunityId       String                     @id
  opportunity         Opportunity                @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  employmentType      OpportunityEmploymentType
  roleTitle           String?                    @db.VarChar(180)
  department          String?                    @db.VarChar(160)
  experienceLevel     OpportunityExperienceLevel @default(UNSPECIFIED)
  weeklyHours         Int?
  durationLabel       String?                    @db.VarChar(120)
  // Absent salary is rendered as "Compensation not specified" — never as a
  // fabricated range and never as "competitive".
  salaryMinMinor      Int?
  salaryMaxMinor      Int?
  salaryCurrency      String?                    @db.VarChar(3)
  salaryPeriod        OpportunitySalaryPeriod?
  salaryNegotiable    Boolean                    @default(false)
  paid                Boolean?
  visaSupport         Boolean?
  housingSupport      Boolean?
  conversionPotential Boolean?
  numberOfOpenings    Int?
  technicalSkills     String[]                   @default([])
  softSkills          String[]                   @default([])
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@index([employmentType, experienceLevel])
}

model OpportunityDegreeLevel {
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  degreeLevel   StudyLevel

  @@id([opportunityId, degreeLevel])
  @@index([degreeLevel, opportunityId])
}

model OpportunityFieldOfStudy {
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fieldKey      String      @db.VarChar(80)

  @@id([opportunityId, fieldKey])
  @@index([fieldKey, opportunityId])
}

model OpportunityLanguageRequirement {
  id              String                   @id @default(cuid())
  opportunityId   String
  opportunity     Opportunity              @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  language        String                   @db.VarChar(80)
  level           OpportunityLanguageLevel
  certificateType String?                  @db.VarChar(80)
  required        Boolean                  @default(true)

  @@unique([opportunityId, language])
  @@index([language, level])
}

// Advisory, explainable eligibility. There is deliberately no opaque numeric
// score column: every result the product shows is derived from these rows and
// is rendered together with its reason.
model OpportunityEligibilityRule {
  id              String                         @id @default(cuid())
  opportunityId   String
  opportunity     Opportunity                    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  ruleType        OpportunityEligibilityRuleType
  operator        OpportunityEligibilityOperator
  structuredValue Json
  required        Boolean                        @default(true)
  publicLabel     String                         @db.VarChar(300)
  sortOrder       Int                            @default(0)
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  @@index([opportunityId, sortOrder])
  @@index([ruleType])
}

model OpportunityBenefit {
  id            String                       @id @default(cuid())
  opportunityId String
  opportunity   Opportunity                  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  type          OpportunityBenefitType
  amountMinor   Int?
  currency      String?                      @db.VarChar(3)
  period        OpportunitySalaryPeriod?
  description   String?                      @db.VarChar(400)
  confidence    OpportunityBenefitConfidence @default(NOT_SPECIFIED)
  sortOrder     Int                          @default(0)

  @@index([opportunityId, sortOrder])
  @@index([type, confidence])
}

model OpportunityApplicationRequirement {
  id                             String                           @id @default(cuid())
  opportunityId                  String
  opportunity                    Opportunity                      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  documentType                   OpportunityDocumentCategory
  required                       Boolean                          @default(true)
  description                    String?                          @db.VarChar(400)
  sortOrder                      Int                              @default(0)
  OpportunityApplicationDocument OpportunityApplicationDocument[]

  @@unique([opportunityId, documentType])
  @@index([opportunityId, sortOrder])
}

model OpportunityApplicationQuestion {
  id            String                         @id @default(cuid())
  opportunityId String
  opportunity   Opportunity                    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  type          OpportunityQuestionType
  label         String                         @db.VarChar(300)
  description   String?                        @db.VarChar(600)
  required      Boolean                        @default(true)
  // Validated at the service boundary against a Zod schema for the question
  // type. Never interpreted as executable logic.
  options       Json?
  sortOrder     Int                            @default(0)
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt
  answers       OpportunityApplicationAnswer[]

  @@index([opportunityId, sortOrder])
}

model OpportunityMedia {
  id            String               @id @default(cuid())
  opportunityId String
  opportunity   Opportunity          @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  mediaId       String               @unique
  media         MediaAsset           @relation("OpportunityMedia", fields: [mediaId], references: [id], onDelete: Cascade)
  kind          OpportunityMediaKind
  isCover       Boolean              @default(false)
  altText       String?              @db.VarChar(240)
  sortOrder     Int                  @default(0)
  createdAt     DateTime             @default(now())

  @@index([opportunityId, sortOrder])
  @@index([opportunityId, isCover])
}

model OpportunitySaved {
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId    String
  opportunity      Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  // Opt-in only. Publishers never see who saved an opportunity.
  remindBeforeDays Int?
  lastRemindedAt   DateTime?
  createdAt        DateTime    @default(now())

  @@id([userId, opportunityId])
  @@index([userId, createdAt])
  @@index([opportunityId])
}

// Private, per-user document vault. Files live in the existing MediaAsset
// pipeline with a dedicated private purpose; attaching the same document to
// several applications reuses this row rather than copying the file.
model UserOpportunityDocument {
  id          String                           @id @default(cuid())
  userId      String
  user        User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaId     String                           @unique
  media       MediaAsset                       @relation("UserOpportunityDocument", fields: [mediaId], references: [id], onDelete: Cascade)
  category    OpportunityDocumentCategory
  displayName String                           @db.VarChar(200)
  institution String?                          @db.VarChar(200)
  issuedOn    DateTime?                        @db.Date
  expiresOn   DateTime?                        @db.Date
  language    String?                          @db.VarChar(80)
  archivedAt  DateTime?
  createdAt   DateTime                         @default(now())
  updatedAt   DateTime                         @updatedAt
  attachments OpportunityApplicationDocument[]

  @@index([userId, category, createdAt])
  @@index([userId, archivedAt])
}

// Private application preferences. Never publicly exposed and never projected
// into a candidate directory.
model UserOpportunityProfile {
  userId                      String                     @id
  user                        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredTypes              OpportunityType[]          @default([])
  preferredCityIds            String[]                   @default([])
  remotePreference            OpportunityWorkMode?
  experienceLevel             OpportunityExperienceLevel @default(UNSPECIFIED)
  availabilityFrom            DateTime?                  @db.Date
  professionalInterests       String[]                   @default([])
  skills                      String[]                   @default([])
  workAuthorizationNote       String?                    @db.VarChar(500)
  portfolioUrl                String?                    @db.VarChar(500)
  professionalProfileUrl      String?                    @db.VarChar(500)
  defaultCvDocumentId         String?
  defaultTranscriptDocumentId String?
  coverLetterTemplate         String?                    @db.Text
  // Opt-in. Absent or false suppresses recommendation notifications entirely.
  recommendationsEnabled      Boolean                    @default(false)
  deadlineReminderDays        Int[]                      @default([])
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
}

model OpportunityApplication {
  id                     String                       @id @default(cuid())
  opportunityId          String
  opportunity            Opportunity                  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  applicantUserId        String
  applicantUser          User                         @relation("OpportunityApplicant", fields: [applicantUserId], references: [id], onDelete: Cascade)
  // Denormalized at submission so reviewer authorization never depends on the
  // opportunity's current publisher, which moderation may change later.
  organizationId         String?
  organization           Organization?                @relation("OrganizationOpportunityApplications", fields: [organizationId], references: [id], onDelete: SetNull)
  status                 OpportunityApplicationStatus @default(DRAFT)
  assignedReviewerUserId String?
  assignedReviewerUser   User?                        @relation("OpportunityApplicationReviewer", fields: [assignedReviewerUserId], references: [id], onDelete: SetNull)

  // Immutable record of what the applicant actually submitted. Later profile
  // edits never rewrite it.
  applicantSnapshot Json?
  consentVersion    String? @db.VarChar(40)

  submittedAt            DateTime?
  withdrawnAt            DateTime?
  decidedAt              DateTime?
  informationRequestedAt DateTime?
  informationDueAt       DateTime?
  offerResponseDueAt     DateTime?
  applicantLastViewedAt  DateTime?
  reviewerLastViewedAt   DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  answers       OpportunityApplicationAnswer[]
  documents     OpportunityApplicationDocument[]
  statusHistory OpportunityApplicationStatusHistory[]
  interviews    OpportunityInterview[]

  // One active application per user and opportunity.
  @@unique([opportunityId, applicantUserId])
  @@index([applicantUserId, status, updatedAt])
  @@index([organizationId, status, submittedAt])
  @@index([opportunityId, status, submittedAt])
  @@index([assignedReviewerUserId, status])
}

model OpportunityInterview {
  id                   String                     @id @default(cuid())
  applicationId        String
  application          OpportunityApplication     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  format               OpportunityInterviewFormat
  scheduledAt          DateTime
  timezone             String                     @db.VarChar(64)
  locationLabel        String?                    @db.VarChar(240)
  meetingUrl           String?                    @db.VarChar(500)
  preparationNote      String?                    @db.VarChar(2000)
  status               OpportunityInterviewStatus @default(PROPOSED)
  createdByUserId      String
  createdByUser        User                       @relation("OpportunityInterviewCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  applicantRespondedAt DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([applicationId, scheduledAt])
  @@index([createdByUserId, createdAt])
  @@index([status, scheduledAt])
}

model OpportunityApplicationAnswer {
  id               String                         @id @default(cuid())
  applicationId    String
  application      OpportunityApplication         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  questionId       String
  question         OpportunityApplicationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerText       String?                        @db.Text
  answerStructured Json?
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt

  @@unique([applicationId, questionId])
  @@index([questionId])
}

model OpportunityApplicationDocument {
  id                  String                             @id @default(cuid())
  applicationId       String
  application         OpportunityApplication             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userDocumentId      String
  userDocument        UserOpportunityDocument            @relation(fields: [userDocumentId], references: [id], onDelete: Cascade)
  requirementId       String?
  requirement         OpportunityApplicationRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  category            OpportunityDocumentCategory
  displayNameSnapshot String                             @db.VarChar(200)
  createdAt           DateTime                           @default(now())

  @@unique([applicationId, userDocumentId])
  @@index([applicationId, category])
  @@index([userDocumentId])
  @@index([requirementId])
}

model OpportunityApplicationStatusHistory {
  id                   String                        @id @default(cuid())
  applicationId        String
  application          OpportunityApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus           OpportunityApplicationStatus?
  toStatus             OpportunityApplicationStatus
  actingUserId         String?
  actingUser           User?                         @relation("OpportunityApplicationStatusActor", fields: [actingUserId], references: [id], onDelete: SetNull)
  // Kept in separate columns so an internal note can never be serialized into
  // an applicant-facing DTO, notification or email by accident.
  applicantVisibleNote String?                       @db.VarChar(2000)
  internalNote         String?                       @db.VarChar(2000)
  createdAt            DateTime                      @default(now())

  @@index([applicationId, createdAt])
  @@index([actingUserId, createdAt])
}

// ---------------------------------------------------------------------------
// Study Essentials
//
// A curated academic catalogue owned by Kondo, not a second marketplace. It
// deliberately does not reuse OrganizationProduct: that domain models an
// organization's own catalogue with contact-based inquiries and its own
// moderation lifecycle, whereas Study Essentials is Kondo-curated and, for
// Kondo-sourced items, actually sold.
// ---------------------------------------------------------------------------

enum StudyEssentialFormat {
  DIGITAL
  PHYSICAL
}

enum StudyEssentialSource {
  KONDO
  PARTNER
}

enum StudyEssentialStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StudyEssentialOrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

/// SIMULATED is the only provider wired for the MVP. The real providers are
/// declared now so adding one is a payment-adapter change, not a schema change.
enum StudyEssentialPaymentProvider {
  SIMULATED
  ALIPAY
  WECHAT_PAY
  CARD
}

model StudyEssential {
  id               String                  @id @default(cuid())
  slug             String                  @unique @db.VarChar(180)
  title            String                  @db.VarChar(180)
  shortDescription String                  @db.VarChar(400)
  description      String                  @db.Text
  category         String                  @db.VarChar(100)
  format           StudyEssentialFormat
  source           StudyEssentialSource    @default(KONDO)
  status           StudyEssentialStatus    @default(DRAFT)
  /// Null means the price lives on the partner's own platform.
  priceMinor       Int?
  currency         String                  @default("CNY") @db.Char(3)
  /// Partner attribution. Always set when source is PARTNER.
  providerName     String?                 @db.VarChar(160)
  externalUrl      String?                 @db.VarChar(500)
  imageUrl         String?                 @db.VarChar(500)
  /// Fallback cover so a catalogue entry never renders as a broken image.
  coverEmoji       String?                 @db.VarChar(16)
  highlights       String[]
  sortOrder        Int                     @default(0)
  publishedAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  orders           StudyEssentialOrder[]
  chapters         StudyEssentialChapter[]
  notes            StudyNote[]
  readingProgress  StudyReadingProgress[]
  courseLinks      CourseResource[]

  @@index([status, sortOrder])
  @@index([status, format])
  @@index([status, source])
}

model StudyEssentialOrder {
  id               String                        @id @default(cuid())
  reference        String                        @unique @db.VarChar(32)
  userId           String
  user             User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  essentialId      String
  essential        StudyEssential                @relation(fields: [essentialId], references: [id], onDelete: Restrict)
  /// Snapshots keep a past order readable after the catalogue entry changes.
  titleSnapshot    String                        @db.VarChar(180)
  formatSnapshot   StudyEssentialFormat
  quantity         Int                           @default(1)
  unitPriceMinor   Int
  totalMinor       Int
  currency         String                        @db.Char(3)
  status           StudyEssentialOrderStatus     @default(PENDING)
  paymentProvider  StudyEssentialPaymentProvider @default(SIMULATED)
  paymentReference String?                       @db.VarChar(120)
  placedAt         DateTime                      @default(now())
  paidAt           DateTime?

  @@index([userId, placedAt])
  @@index([essentialId, status])
}

// ---------------------------------------------------------------------------
// Study workspace
//
// The reading side of Study Essentials. A purchased essential becomes a
// readable resource, a selection becomes a highlight, a highlight becomes a
// note, and a note can raise a task — in the existing AcademicTask system
// rather than a second one. AcademicTask itself is untouched: the link lives
// on the note, so the planner keeps owning tasks.
// ---------------------------------------------------------------------------

model StudyEssentialChapter {
  id          String                 @id @default(cuid())
  essentialId String
  essential   StudyEssential         @relation(fields: [essentialId], references: [id], onDelete: Cascade)
  position    Int
  title       String                 @db.VarChar(200)
  body        String                 @db.Text
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  notes       StudyNote[]
  progress    StudyReadingProgress[]

  @@unique([essentialId, position])
  @@index([essentialId, position])
}

model StudyReadingProgress {
  id          String                 @id @default(cuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  essentialId String
  essential   StudyEssential         @relation(fields: [essentialId], references: [id], onDelete: Cascade)
  chapterId   String?
  chapter     StudyEssentialChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  lastReadAt  DateTime               @default(now())

  @@unique([userId, essentialId])
  @@index([userId, lastReadAt])
}

/// A resource the student has attached to one of their courses.
///
/// Ownership is not stored here and is not implied by it: My Library remains
/// the only answer to "do I own this", through a PAID StudyEssentialOrder.
/// This records something different and per-student — "Physics Fundamentals is
/// the book I use for Physics" — so Workspace can surface the right resource
/// when Physics is on the timetable, without duplicating the library.
model CourseResource {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      ScheduleCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  essentialId String
  essential   StudyEssential @relation(fields: [essentialId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@unique([userId, courseId, essentialId])
  @@index([userId, courseId])
  @@index([essentialId])
}

/// Something a student captured during or after one class: a typed line, a
/// photo of the board, a handout, or a spoken note.
///
/// This is deliberately not a `StudyNote`. A `StudyNote` is anchored to a book
/// and a chapter — `essentialId` is required — and a photo of a whiteboard
/// belongs to the class, not to any book. Rather than weaken that model's
/// invariant, the class-anchored capture gets its own table.
model CourseCapture {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    ScheduleCourse    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  kind      CourseCaptureKind
  /// What the student typed. A capture may be text only, file only, or both.
  body      String?           @db.Text
  mediaId   String?           @unique
  media     MediaAsset?       @relation("CourseCaptureMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  createdAt DateTime          @default(now())

  @@index([userId, courseId, createdAt])
}

enum CourseCaptureKind {
  NOTE
  PHOTO
  DOCUMENT
  VOICE
}

model StudyNote {
  id          String                 @id @default(cuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  essentialId String
  essential   StudyEssential         @relation(fields: [essentialId], references: [id], onDelete: Cascade)
  chapterId   String?
  chapter     StudyEssentialChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  /// The passage the student selected, kept verbatim.
  highlight   String?                @db.VarChar(2000)
  /// What the student wrote about it. A highlight alone is a valid note.
  body        String?                @db.Text
  /// Set when this note raised a task. The task stays owned by the planner.
  taskId      String?
  task        AcademicTask?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([userId, createdAt])
  @@index([essentialId, userId])
}
