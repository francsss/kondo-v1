  listingImageFor                  ListingImage?                     @relation("ListingImageMedia")
  housingListingMedia              HousingListingMedia?              @relation("HousingListingMedia")
  guideCoverFor                    Guide?                            @relation("GuideCover")
  scheduleImportFile               ScheduleImportFile?
  storyVideoFor                    Story?                            @relation("StoryVideo")
  storyPosterFor                   Story?                            @relation("StoryPoster")
  officialVerificationDocument     OfficialVerificationDocument?     @relation("OfficialVerificationDocument")
  organizationVerificationDocument OrganizationVerificationDocument? @relation("OrganizationVerificationDocument")
  rejectionReason                  String?                           @db.VarChar(500)
  retainedAt                       DateTime?
  retentionReason                  String?                           @db.VarChar(500)
  removedAt                        DateTime?
  removedById                      String?
  removedBy                        User?                             @relation("MediaRemovedBy", fields: [removedById], references: [id], onDelete: SetNull)
  storageDeletePending             Boolean                           @default(false)
  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt

  @@index([ownerId, status, createdAt])
  @@index([status, uploadExpiresAt])
  @@index([status, attachedAt, createdAt])
  @@index([purpose, status, createdAt])
  @@index([scanStatus, status])
  @@index([attachmentType, attachmentId])
  @@index([replacesId])
  @@index([retainedAt, status])
}

model AccountRequest {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation("AccountRequestOwner", fields: [userId], references: [id], onDelete: Cascade)
  type          AccountRequestType
  status        AccountRequestStatus @default(PENDING)
  reason        String?              @db.VarChar(1000)
  responseNote  String?              @db.VarChar(2000)
  version       Int                  @default(1)
  processedById String?
  processedBy   User?                @relation("AccountRequestProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  processedAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([userId, createdAt])
  @@index([status, type, createdAt])
  @@index([processedById, status])
}

model AuditLog {
  id             String        @id @default(cuid())
  actorId        String?
  actor          User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String
  oldValue       Json?
  newValue       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  @@index([actorId])
  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model AnalyticsEvent {
  id         String             @id @default(cuid())
  userId     String?
  user       User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  name       AnalyticsEventName
  properties Json?
  sessionId  String?
  createdAt  DateTime           @default(now())

  @@index([name, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId])
}

model UserPresence {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientSessionId String   @db.VarChar(64)
  connectedAt     DateTime
  lastSeen        DateTime
  currentPath     String   @db.VarChar(240)
  device          String   @db.VarChar(32)
  browser         String   @db.VarChar(32)
  operatingSystem String   @db.VarChar(32)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([lastSeen])
  @@index([connectedAt])
}

model OAuthAccount {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
  @@index([expiresAt])
}
