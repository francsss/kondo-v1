generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection used by the application at runtime (e.g. Neon/PgBouncer).
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection used only by Prisma Migrate/introspection.
  // On managed serverless Postgres, running migrations through a transaction
  // pooler is unreliable; `directUrl` lets `prisma migrate deploy` use a direct
  // connection while the app keeps using the pooled one. Set it to the same
  // value as DATABASE_URL for a non-pooled/local database.
  directUrl = env("DIRECT_URL")
}

