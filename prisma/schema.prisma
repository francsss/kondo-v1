enum CityHubStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

// Editorial record for an "Explore your city" hub. Content is edited as a
// structured JSON payload (validated against the ExploreCity shape in
// src/lib/validation.ts) and moves through DRAFT -> REVIEW -> PUBLISHED.
// `draft` always holds the working copy; `published` holds the live public
// snapshot and is only overwritten on publish, so the public site keeps
// serving the last published version while a revision is in progress. Cities
// with no CityHub row (or no published snapshot) fall back to the static
// typed registry in src/features/explore.
model CityHub {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  cityId      String?       @unique
  city        City?         @relation(fields: [cityId], references: [id], onDelete: SetNull)
  status      CityHubStatus @default(DRAFT)
  draft       Json
  published   Json?
  version     Int           @default(1)
  publishedAt DateTime?
  createdById String
  createdBy   User          @relation("CityHubAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String?
  updatedBy   User?         @relation("CityHubEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, updatedAt])
}

