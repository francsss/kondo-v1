model MediaAsset {
  id                               String                            @id @default(cuid())
  ownerId                          String?
  owner                            User?                             @relation("MediaOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  objectKey                        String                            @unique
  storageProvider                  MediaStorageProvider
  kind                             MediaKind
  purpose                          MediaPurpose
  visibility                       MediaVisibility
  status                           MediaStatus                       @default(PENDING)
  scanStatus                       MediaScanStatus                   @default(PENDING)
  originalFileName                 String                            @db.VarChar(255)
  extension                        String                            @db.VarChar(16)
  declaredMime                     String                            @db.VarChar(120)
  detectedMime                     String?                           @db.VarChar(120)
  sizeBytes                        Int
  width                            Int?
